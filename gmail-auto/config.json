{
  "email_client": {
    "type": "gmail",
    "credentials_file": "credentials.json",
    "token_file": "token.json",
    "scopes": ["https://www.googleapis.com/auth/gmail.modify"]
  },
  "email_poller": {
    "poll_interval_seconds": 5,
    "poll_timeout_seconds": 60,
    "filters": {
      "sender": "noreply@redditmail.com",
      "subject": "is your Reddit verification code"
    }
  },
  "code_parser": {
    "regex": "(\\d{6})"
  },
  "ai_parser": {
    "enabled": true,
    "prompt": "From the following email text, extract the 6-digit verification code. Return only the numerical code and nothing else. Text: "
  },
  "trigger_actions": {
    "target_url": "https://example.com/verify?code={code}"
  }
}
